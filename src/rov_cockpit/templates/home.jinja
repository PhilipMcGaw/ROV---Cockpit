        <!-- Custom scripts -->

        <script type="text/javascript">
            // Dynamic examples

            var attitude = $.flightIndicator('#attitude', 'attitude', {roll:0, pitch:0, size:200, showBox: true});
            var heading = $.flightIndicator('#heading', 'heading', {heading:0, showBox: true});
            var pitchIndicator = $.flightIndicator('#pitch', 'attitude', {roll:0, pitch:0, size:200, showBox: true});
            var cameraPitchIndicator = $.flightIndicator('#camera-pitch', 'attitude', {roll:0, pitch:0, size:200, showBox: true});
            var variometer = $.flightIndicator('#variometer', 'variometer', {vario:0, showBox : false});
            var airspeed = $.flightIndicator('#airspeed', 'airspeed', {showBox: false});
            var turn_coordinator = $.flightIndicator('#turn_coordinator', 'turn_coordinator', {turn:0});
        </script>

        <script type="text/javascript">
            const uptimeElement = document.getElementById("upTime");        // Uptime
            const voltElement = document.getElementById("batteryVoltage");  // Battery Voltage
            const socElement = document.getElementById("batteryLevel");     // State of Charge
            const tempElement = document.getElementById("temperature");     // Water Temperature
            const depthElement = document.getElementById("depth");          // Depth (this is a positive number…)
            const compassElement = document.getElementById('compass');      // Compass bearing

            function router(topic, message) {
                if (topic === "system/uptime") {
                    if (uptimeElement) {
                        uptimeElement.innerHTML = "<i class=\"fa-solid fa-hourglass-half\"></i> " + message.toString();
                    }
                }

                if (topic === "input/analog/battery/voltage") {
                    if (voltElement) {
                        voltElement.innerHTML = message.toString() + " V";
                    }
                }

                if (topic === "input/analog/battery/percentage") {
                    if (socElement) {
                        batteryLevel = message.toString() * 10;
                        // less than 20 %
                        if (batteryLevel < 20) {
                            batteryIcon = "fa-battery-empty text-danger";
                        }
                        // less than 40 % 
                        else if (batteryLevel < 40) {
                            batteryIcon = "fa-battery-quarter text-warning";
                        }
                        // less than 60 % 
                        else if (batteryLevel < 60) {
                            batteryIcon = "fa-battery-half";
                        }
                        // less than 80
                        else if (batteryLevel < 80) {
                            batteryIcon = "fa-battery-three-quarters";
                        }
                        // All other values
                        else {
                            batteryIcon = "fa-battery-full text-success";
                        }
                        document.getElementById('batteryLevel').innerHTML =  "<i class=\"fas " + batteryIcon + " fa-lg\"></i>";
                    }
                }

                if (topic === "sensor/water/depth") {
                    if (window.updateAltitudeStrip) {
                        window.updateAltitudeStrip(message.toString() * 10);
                    }
                }

                if (topic === "sensor/ahrs/imu/heading") {
                    if (compassElement) {
                        compassElement.innerHTML = "<i class=\"fa-regular fa-compass fa-lg\"></i> " + message.toString() + " &deg";
                        heading.setHeading(message.toString());             // This updates the compass
                    }
                    if (window.updateHeadingStrip) {
                        window.updateHeadingStrip(message.toString());
                    }
                }

                if (topic === "sensor/ahrs/imu/pitch") {
                    const pitch = Number(message);
                    if (Number.isFinite(pitch)) {
                        attitude.setPitch(pitch);
                        pitchIndicator.setPitch(pitch);
                    }
                }
                if (topic === "sensor/ahrs/imu/roll") {
                    attitude.setRoll(50*Math.sin(message.toString()/10));
                    // TC update - note that the TC appears opposite the angle of the attitude indicator, as it mirrors the actual wing up/down position
                    turn_coordinator.setTurn((30*Math.sin(message.toString()/10))*-1);
                  }

                if (topic === "sensor/camera/main/pitch") {
                    const cameraPitch = Number(message);
                    if (Number.isFinite(cameraPitch)) {
                        cameraPitchIndicator.setPitch(cameraPitch);
                    }
                }

                if (topic === "sensor/water/temperature") {
                    if (tempElement) {
                        tempElement.innerHTML = "<i class=\"fa-solid fa-temperature-half\"></i>&nbsp;" + message.toString()  + " &deg;C";
                    }
                }
            }

            let telemetrySocket;
            let reconnectTimer;

            function connectTelemetry() {
                const protocol = location.protocol === "https:" ? "wss:" : "ws:";
                telemetrySocket = new WebSocket(`${protocol}//${location.host}/ws/telemetry`);
                telemetrySocket.onopen = () => console.log("Connected to Cockpit telemetry");
                telemetrySocket.onmessage = (event) => {
                    const update = JSON.parse(event.data);
                    router(update.topic, update.value);
                };
                telemetrySocket.onclose = () => {
                    clearTimeout(reconnectTimer);
                    reconnectTimer = setTimeout(connectTelemetry, 2000);
                };
                telemetrySocket.onerror = () => telemetrySocket.close();
            }

            connectTelemetry();
        </script>
