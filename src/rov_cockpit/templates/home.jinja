    <style>
        .heading-strip {
            position: fixed;
            z-index: 20;
            top: calc(var(--rov-nav-height, 60px) + var(--rov-overlay-gap, 8px));
            left: 50%;
            width: min(680px, 72vw);
            height: 72px;
            transform: translateX(-50%);
            overflow: hidden;
            color: #fff;
            background: linear-gradient(to bottom, rgba(20, 35, 48, .78), rgba(20, 35, 48, .18));
            border-radius: 12px;
            text-shadow: 0 1px 3px #000;
        }

        .heading-strip-value {
            position: absolute;
            top: 3px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            font: 600 15px Arial, sans-serif;
            color: #ffb000;
        }

        .heading-strip-title {
            position: absolute;
            top: 3px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            color: #fff;
            font: 600 12px Arial, sans-serif;
        }

        .heading-strip-scale {
            position: absolute;
            top: 32px;
            left: 50%;
            display: flex;
            gap: 0;
            transform: translateX(-50%);
            transition: transform .25s ease-out;
        }

        .heading-tick {
            position: relative;
            width: 84px;
            height: 34px;
            box-sizing: border-box;
            padding-top: 13px;
            border-top: 1px solid rgba(255,255,255,.8);
            text-align: center;
            font: 10px Arial, sans-serif;
        }

        .heading-tick::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 50%;
            height: 10px;
            border-left: 1px solid rgba(255,255,255,.9);
        }

        .heading-tick.cardinal { font-weight: 700; color: #dcecff; }
        .heading-strip-pointer {
            position: absolute;
            top: 28px;
            left: 50%;
            z-index: 2;
            width: 0;
            height: 0;
            transform: translateX(-50%);
            border-left: 7px solid transparent;
            border-right: 7px solid transparent;
            border-top: 14px solid #ffb000;
        }

        .network-rate {
            position: fixed;
            z-index: 3;
            top: calc(var(--rov-nav-height) + 6px);
            right: 14px;
            display: flex;
            gap: 12px;
            padding: 5px 9px;
            border-radius: 8px;
            color: #fff;
            background: rgba(20, 35, 48, .72);
            font: 11px Arial, sans-serif;
            text-shadow: 0 1px 3px #000;
        }

        .network-arrow { color: #ffb000; font-size: 15px; }

        .altitude-strip {
            position: fixed;
            z-index: 3;
            top: calc(var(--rov-nav-height) + 84px);
            left: 12px;
            width: 92px;
            height: min(360px, 48vh);
            overflow: hidden;
            color: #fff;
            background: linear-gradient(to right, rgba(20, 35, 48, .78), rgba(20, 35, 48, .18));
            border-radius: 12px;
            text-shadow: 0 1px 3px #000;
        }

        .altitude-strip-title, .altitude-strip-value {
            position: absolute;
            z-index: 2;
            width: 100%;
            text-align: center;
            font: 600 12px Arial, sans-serif;
        }
        .altitude-strip-title { top: 8px; }
        .altitude-strip-value { top: 28px; color: #ffb000; }
        .altitude-strip-scale { position: absolute; top: 50%; left: 0; width: 100%; transform: translateY(-50%); transition: transform .25s ease-out; }
        .altitude-tick { position: relative; height: 34px; border-right: 1px solid rgba(255,255,255,.8); text-align: right; padding: 8px 13px 0 0; box-sizing: border-box; font: 10px Arial, sans-serif; }
        .altitude-tick::after { content: ""; position: absolute; top: 0; right: -1px; width: 12px; border-top: 1px solid rgba(255,255,255,.9); }
        .altitude-strip-pointer { position: absolute; top: 50%; right: 0; z-index: 2; width: 0; height: 0; transform: translateY(-50%); border-top: 7px solid transparent; border-bottom: 7px solid transparent; border-right: 14px solid #ffb000; }
    </style>

    <script>
        (() => {
            const scale = document.getElementById('headingStripScale');
            const value = document.getElementById('headingStripValue');
            const labels = {0: 'N', 45: 'NE', 90: 'E', 135: 'SE', 180: 'S', 225: 'SW', 270: 'W', 315: 'NW'};
            const ticks = [];
            for (let degree = -720; degree <= 720; degree += 15) {
                const normalized = ((degree % 360) + 360) % 360;
                const tick = document.createElement('div');
                tick.className = 'heading-tick' + (labels[normalized] ? ' cardinal' : '');
                tick.textContent = labels[normalized] || `${normalized}°`;
                scale.appendChild(tick);
                ticks.push(tick);
            }

            window.updateHeadingStrip = (heading) => {
                const numericHeading = Number(heading);
                const effectiveHeading = Number.isFinite(numericHeading) ? numericHeading : 0;
                const normalized = ((effectiveHeading % 360) + 360) % 360;
                value.textContent = `${Math.round(normalized)}°`;
                const offset = (normalized / 15) * 84;
                scale.style.transform = `translateX(calc(-50% - ${offset}px))`;
            };
            window.updateHeadingStrip(0);
        })();
    </script>
    <script>
        (() => {
            const scale = document.getElementById('altitudeStripScale');
            const value = document.getElementById('altitudeStripValue');
            if (!scale || !value) return;
            for (let metres = -10; metres <= 10; metres += 1) {
                const tick = document.createElement('div');
                tick.className = 'altitude-tick';
                tick.textContent = `${metres} m`;
                scale.appendChild(tick);
            }
            window.updateAltitudeStrip = (depthDecimetres) => {
                const depth = Number(depthDecimetres) / 10;
                if (!Number.isFinite(depth)) {
                    value.textContent = '-- m';
                    return;
                }
                const metres = -depth;
                value.textContent = `${metres.toFixed(1)} m`;
                scale.style.transform = `translateY(calc(-50% - ${metres * 34}px))`;
            };
        })();
    </script>
