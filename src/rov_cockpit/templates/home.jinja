{% extends "base.jinja" %}
{% block title %}home — ROV{% endblock %}
{% block body_class %}rov-live-page{% endblock %}
{% block content %}
<!-- Main area -->

    <!-- Main Camera feed! -->

    <div class="bg-image">
        <img id="mainCamera" src="/cam1" alt="Main ROV camera" />
    </div>

    <div class="network-rate" aria-label="Estimated browser network rate" title="Estimated HTTP traffic between this browser and the Cockpit server">
        <span><i class="fa-solid fa-arrow-down network-arrow" aria-hidden="true"></i> <span id="downloadRate">--</span> kB/s</span>
        <span><i class="fa-solid fa-arrow-up network-arrow" aria-hidden="true"></i> <span id="uploadRate">--</span> kB/s</span>
    </div>

    <style>
        .network-rate {
            position: fixed;
            z-index: 3;
            top: calc(var(--rov-topbar-height) + 6px);
            right: 14px;
            display: flex;
            gap: 12px;
            padding: 5px 9px;
            border-radius: 8px;
            color: #fff;
            background: rgba(20, 35, 48, .72);
            font: 11px Arial, sans-serif;
            text-shadow: 0 1px 3px #000;
        }

        .network-arrow { color: #ffb000; font-size: 15px; }

    </style>

    <!-- The TypeScript build emits ES modules; map Vue to the committed runtime vendor asset. -->
    
    
    

    

    

<!--
    <div  class="bg-image vh-100"
        style="margin-top: -60px;
        background-image: url('/static/background.jpg');">
    </div>
-->

    <rov-hud id="rov-hud" aria-label="ROV navigation HUD"></rov-hud>
    <rov-instrument-style-editor target="rov-hud" profile="rov"></rov-instrument-style-editor>
    <div data-vue-instrument="live-dock"></div>

    <!-- End your project here-->

        <!-- Custom scripts -->

        
{% endblock %}
{% block scripts %}
<script type="module" src="/static/dist/components/rov-depth.js"></script>
<script>
        (() => {
            const download = document.getElementById('downloadRate');
            const upload = document.getElementById('uploadRate');
            let previous = performance.now();
            let downBytes = 0;
            let upBytes = 0;

            const update = () => {
                const now = performance.now();
                const elapsed = Math.max((now - previous) / 1000, 0.1);
                download.textContent = (downBytes / elapsed / 1024).toFixed(1);
                upload.textContent = (upBytes / elapsed / 1024).toFixed(1);
                downBytes = 0;
                upBytes = 0;
                previous = now;
            };

            const measure = async () => {
                const requestBytes = 64;
                const response = await fetch(`/api/network-ping?ts=${Date.now()}`, {cache: 'no-store'});
                const body = await response.arrayBuffer();
                upBytes += requestBytes;
                downBytes += Number(response.headers.get('content-length')) || body.byteLength;
            };

            setInterval(() => { measure().catch(() => {}); }, 2000);
            setInterval(update, 1000);
            measure().catch(() => {});
        })();
    </script>
<script>
        (() => {
            const camera = document.getElementById('mainCamera');
            const liveSource = '/cam1';
            const fallbackSource = '/static/background.jpg';
            const retryDelayMs = 5000;
            let showingFallback = false;

            function useFallback() {
                if (!showingFallback) {
                    showingFallback = true;
                    camera.src = fallbackSource;
                }
                window.setTimeout(checkCamera, retryDelayMs);
            }

            function checkCamera() {
                const probe = new Image();
                probe.onload = () => {
                    showingFallback = false;
                    camera.src = liveSource + '?retry=' + Date.now();
                };
                probe.onerror = () => window.setTimeout(checkCamera, retryDelayMs);
                probe.src = liveSource + '?probe=' + Date.now();
            }

            camera.onerror = useFallback;
            window.setTimeout(checkCamera, retryDelayMs);
        })();
    </script>
<script type="text/javascript">
            const uptimeElement = document.getElementById("upTime");        // Uptime
            const tempElement = document.getElementById("temperature");     // Water Temperature
            const depthElement = document.getElementById("depth");          // Depth (this is a positive number…)

            function router(topic, message) {
                if (topic === "system/uptime") {
                    if (uptimeElement) {
                        uptimeElement.innerHTML = "<i class=\"fa-solid fa-hourglass-half\"></i> " + message.toString();
                    }
                }

                if (topic === "sensor/ahrs/imu/roll") {
                    // Roll and pitch are rendered by the combined ROV HUD.
                }

                if (topic === "sensor/water/temperature") {
                    if (tempElement) {
                        tempElement.innerHTML = "<i class=\"fa-solid fa-temperature-half\"></i>&nbsp;" + message.toString()  + " &deg;C";
                    }
                }
            }

            let telemetrySocket;
            let reconnectTimer;

            function connectTelemetry() {
                const protocol = location.protocol === "https:" ? "wss:" : "ws:";
                telemetrySocket = new WebSocket(`${protocol}//${location.host}/ws/telemetry`);
                telemetrySocket.onopen = () => console.log("Connected to Cockpit telemetry");
                telemetrySocket.onmessage = (event) => {
                    const update = JSON.parse(event.data);
                    router(update.topic, update.value);
                };
                telemetrySocket.onclose = () => {
                    clearTimeout(reconnectTimer);
                    reconnectTimer = setTimeout(connectTelemetry, 2000);
                };
                telemetrySocket.onerror = () => telemetrySocket.close();
            }

            connectTelemetry();
        </script>
{% endblock %}
