    <script>
        (() => {
            const toggle = document.querySelector('.rov-menu-toggle');
            const panel = document.getElementById('rov-menu-popover');
            if (!toggle || !panel) return;
            const setOpen = (open) => {
                toggle.setAttribute('aria-expanded', String(open));
                toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
                panel.hidden = !open;
                document.body.classList.toggle('rov-menu-open', open);
            };
            toggle.addEventListener('click', () => setOpen(panel.hidden));
            document.addEventListener('click', (event) => {
                if (!panel.hidden && !panel.contains(event.target) && event.target !== toggle && !toggle.contains(event.target)) setOpen(false);
            });
            document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
        })();
        fetch('/api/session', {cache: 'no-store', credentials: 'same-origin'}).then(response => response.json()).then(session => {
            const link = document.getElementById('sessionLink');
            if (!link || !session.authenticated) return;
            link.href = '/logout';
            link.innerHTML = `<i class="fa-solid fa-right-from-bracket"></i>&nbsp;${session.username}`;
            link.title = 'Log out';
        }).catch(() => {});
    </script>


